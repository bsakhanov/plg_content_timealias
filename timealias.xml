<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>plg_content_timealias</name>
    <author>Beibit Sakhanov</author>
    <creationDate>2026-10-06</creationDate>
    <copyright>(C) 2026 Beibit Sakhanov</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE</license>
    <authorEmail>info@webmarka.kz</authorEmail>
    <authorUrl>https://webmarka.kz</authorUrl>
    <version>1.0.0</version>
    <description>PLG_CONTENT_TIMEALIAS_XML_DESCRIPTION</description>
    <namespace path="src">Webmarka\Plugin\Content\Timealias</namespace>
    <files>
        <folder plugin="timealias">services</folder>
        <folder>src</folder>
        <folder>language</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="keep_alias"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    label="PLG_CONTENT_TIMEALIAS_KEEP_ALIAS_LABEL"
                    description="PLG_CONTENT_TIMEALIAS_KEEP_ALIAS_DESC"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
